# Safe demonstration defaults. Keep DRY_RUN enabled unless you deliberately
# configure a controlled staging environment.
DRY_RUN=true

# Optional OpenAI integration (never commit real values)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional SERP enrichment. It is not required by the demo workflow.
SCRAPINGDOG_API_KEY=your_scrapingdog_api_key

# Optional publication adapter. Example values only.
FTP_HOST=example.com
FTP_PORT=21
FTP_USER=your_user
FTP_PASSWORD=your_password
FTP_REMOTE_DIR=/public_html

# Optional WordPress bridge and Google services. Leave blank for the demo.
WORDPRESS_BRIDGE_URL=https://example.com/wp-json/satellite/v1/content
WORDPRESS_BRIDGE_TOKEN=your_wordpress_bridge_token
GOOGLE_OAUTH_CREDENTIALS_PATH=credentials/google-oauth-client.json
GOOGLE_INDEXING_TOKEN_PATH=credentials/google-indexing-token.json
